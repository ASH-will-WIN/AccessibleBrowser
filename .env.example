# Runtime configuration for the Electron/Jac application.
# Copy to .env locally and never commit the populated file.
# NVIDIA NIM online planner configuration. Keep the populated .env file local.
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
ACCESSIBLE_BROWSER_JAC_URL=http://127.0.0.1:8000
ACCESSIBLE_BROWSER_JAC_API_URL=http://127.0.0.1:8002
